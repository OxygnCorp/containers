{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":timezone(Europe/Paris)",
    "helpers:pinGitHubActionDigestsToSemver",
  ],
  schedule: ["at any time"],
  configMigration: true,
  // Renovate v44+ defaults to timestamp-required for minimumReleaseAge, which
  // permanently pends docker digest updates from registries that provide no
  // publish timestamp (ghcr.io, quay — anything non-Docker Hub provides none,
  // for tags as well as digests). Keep automerge branches viable.
  // Trade-off: those updates skip the quarantine entirely — the required CI
  // is the remaining guard.
  minimumReleaseAgeBehaviour: "timestamp-optional",
  logLevelRemap: [
    {
      matchMessage: "/Some .+ did not have a releaseTimestamp, but as we're running with minimumReleaseAgeBehaviour=timestamp-optional, proceeding/",
      newLogLevel: "info",
    },
  ],
  automergeStrategy: "squash",
  customManagers: [
    {
      customType: "regex",
      description: "Process Annotations in Docker Bake",
      managerFilePatterns: ["/(^|/)docker-bake\\.hcl$/"],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+ = "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      customType: "regex",
      description: "Process Annotations in Dockerfiles",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],
  customDatasources: {
    qbittorrent: {
      defaultRegistryUrlTemplate: "https://github.com/userdocs/qbittorrent-nox-static/releases/latest/download/dependency-version.json",
      format: "json",
      transformTemplates: ['{"releases":[{"version": qbittorrent}]}'],
    },
    "servarr-develop": {
      defaultRegistryUrlTemplate: "https://{{packageName}}.servarr.com/v1/update/develop/changes?os=linux&runtime=netcore",
      format: "json",
      transformTemplates: ['{"releases":[{"version": $[0].version}]}'],
    },
    "servarr-nightly": {
      defaultRegistryUrlTemplate: "https://{{packageName}}.servarr.com/v1/update/nightly/changes?os=linux&runtime=netcore",
      format: "json",
      transformTemplates: ['{"releases":[{"version": $[0].version}]}'],
    },
    "sonarr-develop": {
      defaultRegistryUrlTemplate: "https://services.sonarr.tv/v1/update/develop/changes?os=linux&runtime=netcore&version=5.0",
      format: "json",
      transformTemplates: ['{"releases":[{"version": $[0].version}]}'],
    },
    plex: {
      defaultRegistryUrlTemplate: "https://plex.tv/api/downloads/5.json",
      format: "json",
      transformTemplates: ['{"releases":[{"version": computer.Linux.version}]}'],
    },
  },
  packageRules: [
    {
      // The Radar graft pins two views of the same upstream dependency: the
      // Dockerfile FROM (tag + registry digest, tracked by the docker
      // datasource) and the VERSION variable in apps/radar/docker-bake.hcl
      // (tracked by the github-releases custom manager). Group them so the
      // grafted image always ships a tag and a digest that exist in lockstep.
      description: ["Group Radar graft version + digest updates"],
      matchDepNames: ["skyhook-io/radar", "ghcr.io/skyhook-io/radar"],
      groupName: "radar",
    },
    {
      description: ["Release Rules for App Updates"],
      addLabels: ["app/{{parentDir}}"],
      additionalBranchPrefix: "{{parentDir}}-",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
      commitMessageTopic: "{{depName}}",
      matchFileNames: ["**/docker-bake.hcl", "**/Dockerfile"],
      semanticCommitScope: "{{parentDir}}",
      semanticCommitType: "release",
    },
    {
      // CI (Go container tests + multi-arch build) must be green: automerge
      // via PR with github native auto-merge, never branch-push.
      description: ["Auto-merge App Updates"],
      matchFileNames: ["**/docker-bake.hcl", "**/Dockerfile"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      minimumReleaseAge: "1 hour",
    },
    {
      // Rolling builds (servarr/sonarr develop & nightly tracks) are never
      // stable releases: keep them out of automerge, they always get a
      // human-reviewed PR. Must come after the "Auto-merge App Updates" rule.
      description: ["Never auto-merge rolling servarr/sonarr builds"],
      matchDatasources: [
        "custom.servarr-develop",
        "custom.servarr-nightly",
        "custom.sonarr-develop",
      ],
      automerge: false,
    },
    {
      // CI runs against the PR anyway, so branch auto-merge does not save
      // anything; keep a human-visible audit trail in PR history.
      description: ["Auto-merge GitHub Actions minor/patch/digest"],
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: true,
      // Supply-chain buffer: only actions that have been published for days.
      minimumReleaseAge: "3 days",
    },
    {
      // Official actions/* and renovatebot/* images: trusted enough for
      // near-zero quarantine window. Only release-type updates; majors,
      // pins and everything else keep the 3-day buffer above.
      description: ["Fast-track GitHub Actions from trusted publishers"],
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "1 minute",
    },
    {
      // Renovate merges these on GitHub native auto-merge WITHOUT waiting
      // for any status check (ignoreTests) — the only guard is branch
      // protection on main (required checks). Keep that enabled.
      description: ["Auto-merge mise tools minor/patch updates"],
      matchManagers: ["mise"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: true,
    },
    {
      description: [
        "Exempt App Updates from prHourlyLimit and create them last, since they still add to the hourly PR count",
      ],
      matchFileNames: ["apps/**"],
      prHourlyLimit: 0,
      prPriority: -1,
    },
    {
      // Fleet automerge policy applies to these two too: no unbounded types.
      description: ["Auto-merge esphome-device-builder Updates"],
      matchDepNames: ["esphome-device-builder"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      ignoreTests: false,
      minimumReleaseAge: "1 hour",
    },
    {
      description: ["Auto-merge tf-runner Updates"],
      matchDepNames: ["ghcr.io/flux-iac/tf-runner"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      ignoreTests: false,
      minimumReleaseAge: "1 hour",
    },
    {
      description: ["Allowed Ubuntu Version for Base Images"],
      matchDatasources: ["docker"],
      matchPackageNames: ["/ubuntu/"],
      allowedVersions: "/26\\.04/",
    },
    {
      description: ["Allowed Alpine Version for Base Images"],
      matchDatasources: ["docker"],
      matchFileNames: ["**/Dockerfile"],
      matchPackageNames: ["/alpine/"],
      allowedVersions: "/3\\.24/",
    },
    {
      description: ["Allowed Alpine Version for Postgres Base Images"],
      matchDatasources: ["docker"],
      matchPackageNames: ["/postgres/"],
      allowedVersions: "/alpine3\\.24/",
    },
    {
      description: ["Allowed Python Version for Alpine Base Images"],
      matchDatasources: ["docker"],
      matchFileNames: ["**/Dockerfile"],
      matchPackageNames: ["/python/"],
      allowedVersions: "/3\\.14-alpine3\\.24/",
    },
    {
      description: ["Allowed Python Version for Debian Base Images"],
      matchDatasources: ["docker"],
      matchFileNames: ["**/Dockerfile"],
      matchPackageNames: ["/python/"],
      allowedVersions: "/3\\.14-slim/",
    },
    {
      description: ["Allowed Node Version for Alpine Base Images"],
      matchDatasources: ["docker"],
      matchFileNames: ["**/Dockerfile"],
      matchPackageNames: ["/node/"],
      allowedVersions: "/26-alpine3\\.24/",
    },
    {
      description: ["Allowed Node Version for Debian Base Images"],
      matchDatasources: ["docker"],
      matchFileNames: ["**/Dockerfile"],
      matchPackageNames: ["/node/"],
      allowedVersions: "/26-trixie-slim/",
    },
    {
      description: ["Allowed Java Version for NZBHydra2 Base Image"],
      matchDatasources: ["docker"],
      matchFileNames: ["apps/nzbhydra2/Dockerfile"],
      matchPackageNames: ["/amazoncorretto/"],
      allowedVersions: "/17-alpine3\\.24/",
    },
    {
      // Defense in depth: nothing ever auto-merges a major bump, whatever the
      // rules above matched. Major bumps keep going through manual review.
      // MUST stay the last rule: later rules override earlier ones.
      description: ["Never auto-merge major updates"],
      matchUpdateTypes: ["major"],
      automerge: false,
    },
  ],
}
